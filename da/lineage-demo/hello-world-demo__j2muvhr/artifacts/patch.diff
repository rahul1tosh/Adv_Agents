+        provider = CountingProvider(*_dummy_provider_args())
+        runner = LineageRunner(SQL, metadata_provider=provider)
+        assert runner.get_table_keys() == EXPECTED_KEYS
+        str(runner)
+        runner.to_cytoscape()
+        runner.to_cytoscape(level=LineageLevel.COLUMN)
+        assert runner.get_table_keys() == EXPECTED_KEYS
+        # each table is looked up at most once
+        assert len(provider.key_lookups) == len(set(provider.key_lookups))
+        assert set(provider.key_lookups) >= {
+            "db2.customers",
+            "db2.orders",
+            "db2.order_items",
