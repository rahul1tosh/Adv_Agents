+@pytest.fixture(scope="module")
+def sqlite_provider() -> SQLAlchemyMetaDataProvider:
+    provider = SQLAlchemyMetaDataProvider("sqlite:///:memory:")
+    with provider.engine.begin() as conn:
+        for ddl in DDL:
+            conn.execute(text(ddl))
+    return provider
