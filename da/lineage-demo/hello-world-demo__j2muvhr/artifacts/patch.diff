+def test_to_cytoscape_table_level():
+    results = []
+    for graph_operator in _gen_graph_operators():
+        with SQLLineageConfig(GRAPH_OPERATOR_CLASS=graph_operator):
+            runner = LineageRunner(SQL, metadata_provider=_dummy_provider())
+            results.append(runner.to_cytoscape())
+    nodes = _nodes(results[0])
+    assert nodes["db2.customers"] == {"id": "db2.customers", "primary_key": ["id"]}
+    assert nodes["db2.orders"] == {
+        "id": "db2.orders",
+        "primary_key": ["order_id"],
+        "foreign_keys": [
+            {
+                "columns": ["customer_id"],
+                "referred_table": "db2.customers",
+                "referred_columns": ["id"],
+            }
+        ],
+    }
+    assert nodes["db2.report"] == {"id": "db2.report"}
+    # networkx and rustworkx agree
+    assert _nodes(results[0]) == _nodes(results[1])
+
+
+def test_to_cytoscape_column_level():
+    results = []
+    for graph_operator in _gen_graph_operators():
+        with SQLLineageConfig(GRAPH_OPERATOR_CLASS=graph_operator):
+            runner = LineageRunner(SQL, metadata_provider=_dummy_provider())
+            results.append(runner.to_cytoscape(level=LineageLevel.COLUMN))
+    nodes = _nodes(results[0])
+    assert nodes["db2.order_items.order_id"]["keys"] == ["PK", "FK"]
+    assert nodes["db2.order_items.line_no"]["keys"] == ["PK"]
+    assert nodes["db2.orders.customer_id"]["keys"] == ["FK"]
+    assert "keys" not in nodes["db2.customers.name"]
+    assert "keys" not in nodes["db2.report.order_id"]
+    assert nodes["db2.orders"] == {
+        "id": "db2.orders",
+        "type": "Table",
+        "primary_key": ["order_id"],
+        "foreign_keys": [
+            {
+                "columns": ["customer_id"],
+                "referred_table": "db2.customers",
+                "referred_columns": ["id"],
+            }
+        ],
+    }
+    assert nodes["db2.customers"]["primary_key"] == ["id"]
+    assert "foreign_keys" not in nodes["db2.customers"]
+    assert nodes["db2.report"] == {"id": "db2.report", "type": "Table"}
+    # networkx and rustworkx agree
+    assert _nodes(results[0]) == _nodes(results[1])
+
