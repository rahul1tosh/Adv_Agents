+def _normalize_key_columns(columns: Iterable[str]) -> tuple[str, ...]:
+    # same normalization as MetaDataProvider.get_table_columns, which goes through Column(name)
+    if isinstance(columns, str):
+        columns = (columns,)
+    return tuple(escape_identifier_name(c) for c in columns)
+
+
+@dataclass(frozen=True)
+class ForeignKey:
+    """
+    Data Class for a foreign key constraint of a table
+    """
+
+    #: constrained columns in the referencing table
+    columns: tuple[str, ...]
+    #: the referred table, as defined by :class:`Table`
+    referred_table: Table
+    #: referred columns in the referred table
+    referred_columns: tuple[str, ...]
+
+    def __post_init__(self):
+        object.__setattr__(self, "columns", _normalize_key_columns(self.columns))
+        object.__setattr__(
+            self, "referred_columns", _normalize_key_columns(self.referred_columns)
+        )
+
+    def __str__(self):
+        return (
+            f"{', '.join(self.columns)} -> "
+            f"{self.referred_table}({', '.join(self.referred_columns)})"
+        )
+
+    def sort_key(self) -> tuple[tuple[str, ...], str, tuple[str, ...]]:
+        # sorted by (columns, referred_table), referred_columns only breaks ties
+        return self.columns, str(self.referred_table), self.referred_columns
+
+
+@dataclass(frozen=True)
+class TableKeys:
+    """
+    Data Class for primary key and foreign keys of a table
+    """
+
+    #: primary key columns, empty when unknown
+    primary_key: tuple[str, ...] = ()
+    #: foreign keys, sorted by (columns, referred_table)
+    foreign_keys: tuple[ForeignKey, ...] = ()
+
+    def __post_init__(self):
+        object.__setattr__(
+            self, "primary_key", _normalize_key_columns(self.primary_key)
+        )
+        object.__setattr__(
+            self,
+            "foreign_keys",
+            tuple(sorted(set(self.foreign_keys), key=ForeignKey.sort_key)),
+        )
+
+    def __bool__(self):
+        return bool(self.primary_key or self.foreign_keys)
+
+    def __str__(self):
+        parts = []
+        if self.primary_key:
+            parts.append(f"PK: {', '.join(self.primary_key)}")
+        if self.foreign_keys:
+            parts.extend(f"FK: {fk}" for fk in self.foreign_keys)
+        return "; ".join(parts)
+
+    @property
+    def foreign_key_columns(self) -> set[str]:
+        return {c for fk in self.foreign_keys for c in fk.columns}
+
+    def to_dict(self) -> dict[str, Any]:
+        result: dict[str, Any] = {}
+        if self.primary_key:
+            result["primary_key"] = list(self.primary_key)
+        if self.foreign_keys:
+            result["foreign_keys"] = [
+                {
+                    "columns": list(fk.columns),
+                    "referred_table": str(fk.referred_table),
+                    "referred_columns": list(fk.referred_columns),
+                }
+                for fk in self.foreign_keys
+            ]
+        return result
