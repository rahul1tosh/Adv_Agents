+class ColumnsOnlyProvider(MetaDataProvider):
+    """a custom provider written before keys support, only with _get_table_columns"""
+
+    def _get_table_columns(self, schema: str, table: str, **kwargs) -> list[str]:
+        return {"db2.orders": ["order_id", "customer_id"]}.get(f"{schema}.{table}", [])
+
+
+class CountingProvider(DummyMetaDataProvider):
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.key_lookups: list[str] = []
+
+    def get_table_keys(self, table: Table) -> TableKeys:
+        self.key_lookups.append(str(table))
+        return super().get_table_keys(table)
+
+
+class FailingKeysProvider(DummyMetaDataProvider):
+    def _get_primary_key(self, schema: str, table: str) -> list[str]:
+        raise RuntimeError("boom")
+
+    def _get_foreign_keys(self, schema: str, table: str) -> list[ForeignKey]:
+        raise RuntimeError("boom")
+
