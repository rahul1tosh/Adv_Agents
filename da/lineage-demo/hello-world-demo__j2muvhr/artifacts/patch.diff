+@pytest.mark.parametrize("level", [LineageLevel.TABLE, LineageLevel.COLUMN])
+def test_to_cytoscape_without_keys_unchanged(level):
+    metadata = _dummy_provider().metadata
+    for graph_operator in _gen_graph_operators():
+        with SQLLineageConfig(GRAPH_OPERATOR_CLASS=graph_operator):
+            provider = DummyMetaDataProvider(metadata)
+            runner = LineageRunner(SQL, metadata_provider=provider)
+            nodes = _nodes(runner.to_cytoscape(level))
+            for data in nodes.values():
+                assert not {"primary_key", "foreign_keys", "keys"} & set(data)
