+    def _get_primary_key(self, schema: str, table: str) -> list[str]:
+        return list(self._reflect_keys(schema, table)[0])
+
+    def _get_foreign_keys(self, schema: str, table: str) -> list[ForeignKey]:
+        return list(self._reflect_keys(schema, table)[1])
+
+    def _reflect_keys(
+        self, schema: str, table: str
+    ) -> tuple[list[str], list[ForeignKey]]:
+        if (cache_key := (schema, table)) in self._keys_cache:
+            return self._keys_cache[cache_key]
+        primary_key: list[str] = []
+        foreign_keys: list[ForeignKey] = []
+        try:
+            inspector = inspect(self.engine)
+            if not inspector.has_table(table, schema=schema):
+                raise NoSuchTableError(f"{schema}.{table}")
+            pk_constraint = inspector.get_pk_constraint(table, schema=schema) or {}
+            primary_key = list(pk_constraint.get("constrained_columns") or [])
+            for fk in inspector.get_foreign_keys(table, schema=schema):
+                if not fk.get("referred_table"):
+                    continue
+                referred_schema: str | None = fk.get("referred_schema") or schema
+                if referred_schema == Schema.unknown:
+                    referred_schema = None
+                foreign_keys.append(
+                    ForeignKey(
+                        columns=tuple(fk.get("constrained_columns") or ()),
+                        referred_table=SQLLineageTable(
+                            fk["referred_table"], Schema(referred_schema)
+                        ),
+                        referred_columns=tuple(fk.get("referred_columns") or ()),
+                    )
+                )
+        except SQLAlchemyError:
+            logger.warning(
+                "error listing keys for table %s.%s in %s, return no keys instead",
+                schema,
+                table,
+                self.engine.url,
+            )
+            primary_key, foreign_keys = [], []
+        self._keys_cache[cache_key] = (primary_key, foreign_keys)
+        return primary_key, foreign_keys
