+def test_models_normalize_and_sort():
+    fk_b = ForeignKey(["Customer_ID"], Table("DB2.Customers"), ["ID"])
+    fk_a = ForeignKey(("a",), Table("db2.zzz"), ("x",))
+    fk_a2 = ForeignKey(("a",), Table("db2.aaa"), ("x",))
+    assert fk_b.columns == ("customer_id",)
+    assert fk_b.referred_columns == ("id",)
+    assert fk_b.referred_table == Table("db2.customers")
+    assert ForeignKey(('"Quoted"',), Table("t"), ("x",)).columns == ("Quoted",)
+    keys = TableKeys(primary_key=["Order_Id"], foreign_keys=(fk_b, fk_a, fk_a2))
+    assert keys.primary_key == ("order_id",)
+    assert keys.foreign_keys == (fk_a2, fk_a, fk_b)
+    assert keys == TableKeys(("order_id",), (fk_a, fk_b, fk_a2))
+    assert hash(keys) == hash(TableKeys(("order_id",), (fk_a, fk_b, fk_a2)))
+    assert keys
+    assert not TableKeys()
+    assert TableKeys() == TableKeys((), ())
+
