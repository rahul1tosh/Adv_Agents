+                    }
+                }
+                for parent, attr in parents_dict.items()
+            ]
+        else:
+            nodes = [
+                {"data": {"id": str(node), **_table_key_data(node, table_keys)}}
+                for node in vertices
+            ]
+        edge_elements: list[dict[str, dict[str, Any]]] = [
+            {"data": {"id": f"e{i}", "source": str(edge[0]), "target": str(edge[1])}}
+            for i, edge in enumerate(edges)
+        ]
+        return nodes + edge_elements
