+def _table_key_data(
+    node: Any, table_keys: Mapping[Table, TableKeys] | None
+) -> dict[str, Any]:
+    if table_keys and isinstance(node, Table) and (keys := table_keys.get(node)):
+        return {
+            "primary_key": list(keys.primary_key),
+            "foreign_keys": [
+                {
+                    "columns": list(fk.columns),
+                    "referred_table": str(fk.referred_table),
+                    "referred_columns": list(fk.referred_columns),
+                }
+                for fk in keys.foreign_keys
+            ],
+        }
+    return {}
+
+
+def _column_key_data(
+    node: Any, table_keys: Mapping[Table, TableKeys] | None
+) -> dict[str, Any]:
+    if (
+        table_keys
+        and isinstance(node, Column)
+        and isinstance(node.parent, Table)
+        and (keys := table_keys.get(node.parent))
+    ):
+        col_keys: list[str] = []
+        if node.raw_name in keys.primary_key:
+            col_keys.append("PK")
+        if any(node.raw_name in fk.columns for fk in keys.foreign_keys):
+            col_keys.append("FK")
+        if col_keys:
+            return {"keys": col_keys}
+    return {}
+
