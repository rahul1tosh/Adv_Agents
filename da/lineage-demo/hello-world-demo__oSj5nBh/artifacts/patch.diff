+        vertices: Sequence[Any],
+        edges: Sequence[tuple[Any, Any]],
+        compound: bool = False,
+        table_keys: Mapping[Table, TableKeys] | None = None,
+    ) -> list[dict[str, dict[str, Any]]]:
