+def _table_key_data(keys: TableKeys) -> dict[str, object]:
+    return {
+        "primary_key": list(keys.primary_key),
+        "foreign_keys": [
+            {
+                "columns": list(fk.columns),
+                "referred_table": str(fk.referred_table),
+                "referred_columns": list(fk.referred_columns),
+            }
+            for fk in keys.foreign_keys
+        ],
+    }
+
+
+def _column_key_tags(
+    column: Column,
+    table_keys: Mapping[Table, TableKeys],
+) -> list[str]:
+    parent = column.parent
+    if not isinstance(parent, Table) or (keys := table_keys.get(parent)) is None:
+        return []
+    tags: list[str] = []
+    if column.raw_name in keys.primary_key:
+        tags.append("PK")
+    if any(column.raw_name in fk.columns for fk in keys.foreign_keys):
+        tags.append("FK")
+    return tags
+
+
+def build_cytoscape_elements(
+    vertices: Sequence[Any],
+    edges: Sequence[tuple[Any, Any]],
+    compound: bool = False,
+    table_keys: Mapping[Table, TableKeys] | None = None,
+) -> list[dict[str, dict[str, object]]]:
+    resolved_keys: Mapping[Table, TableKeys] = table_keys or {}
+    nodes: list[dict[str, dict[str, object]]] = []
+    if compound:
+        parents_dict: dict[Any, dict[str, str]] = {}
+        for vertex in vertices:
+            parent = getattr(vertex, "parent", None)
+            parent_name = str(parent) if parent is not None else "<unknown>"
+            parent_type = (
+                type(parent).__name__ if parent is not None else "Table or SubQuery"
+            )
+            parents_dict[parent] = {"name": parent_name, "type": parent_type}
+        for vertex in vertices:
+            parent = getattr(vertex, "parent", None)
+            parent_candidates = getattr(vertex, "parent_candidates", [])
+            col_data: dict[str, object] = {
+                "id": str(vertex),
+                "parent": parents_dict[parent]["name"],
+                "parent_candidates": [
+                    {"name": str(p), "type": type(p).__name__}
+                    for p in parent_candidates
+                ],
+                "type": type(vertex).__name__,
+            }
+            if isinstance(vertex, Column):
+                if key_tags := _column_key_tags(vertex, resolved_keys):
+                    col_data["keys"] = key_tags
+            nodes.append({"data": col_data})
+        for parent, attr in parents_dict.items():
+            parent_data: dict[str, object] = {
+                "id": attr["name"],
+                "type": attr["type"],
+            }
+            if isinstance(parent, Table) and (keys := resolved_keys.get(parent)):
+                parent_data.update(_table_key_data(keys))
+            nodes.append({"data": parent_data})
+    else:
+        for vertex in vertices:
+            node_data: dict[str, object] = {"id": str(vertex)}
+            if isinstance(vertex, Table) and (keys := resolved_keys.get(vertex)):
+                node_data.update(_table_key_data(keys))
+            nodes.append({"data": node_data})
+
+    edge_elements: list[dict[str, dict[str, object]]] = [
+        {"data": {"id": f"e{i}", "source": str(src), "target": str(tgt)}}
+        for i, (src, tgt) in enumerate(edges)
+    ]
+    return nodes + edge_elements
