+def test_to_cytoscape_table_and_column_keys_match_across_graph_operators():
+    sql = """INSERT INTO db2.summary
+SELECT o.order_id, o.customer_id, oi.order_id AS item_order_id, c.name
+FROM db2.orders o
+JOIN db2.customers c ON o.customer_id = c.id
+JOIN db2.order_items oi ON o.order_id = oi.order_id"""
+
+    nx_cls, rx_cls = _gen_graph_operators()
+    for keyed_provider in _build_keyed_providers():
+        with SQLLineageConfig(GRAPH_OPERATOR_CLASS=nx_cls):
+            nx_runner = LineageRunner(sql, metadata_provider=keyed_provider)
+            nx_table = nx_runner.to_cytoscape()
+            nx_col = nx_runner.to_cytoscape(level=LineageLevel.COLUMN)
+        with SQLLineageConfig(GRAPH_OPERATOR_CLASS=rx_cls):
+            rx_runner = LineageRunner(sql, metadata_provider=keyed_provider)
+            rx_table = rx_runner.to_cytoscape()
+            rx_col = rx_runner.to_cytoscape(level=LineageLevel.COLUMN)
+
+        assert nx_table == rx_table
+        assert nx_col == rx_col
+
+        table_nodes = {
+            e["data"]["id"]: e["data"]
+            for e in nx_table
+            if "source" not in e["data"]
+        }
+        expected_customers_node = {
+            "id": "db2.customers",
+            "primary_key": ["id"],
+            "foreign_keys": [],
+        }
+        expected_orders_node = {
+            "id": "db2.orders",
+            "primary_key": ["order_id"],
+            "foreign_keys": [
+                {
+                    "columns": ["customer_id"],
+                    "referred_table": "db2.customers",
+                    "referred_columns": ["id"],
+                }
+            ],
+        }
+        expected_items_node = {
+            "id": "db2.order_items",
+            "primary_key": ["order_id", "item_id"],
+            "foreign_keys": [
+                {
+                    "columns": ["order_id"],
+                    "referred_table": "db2.orders",
+                    "referred_columns": ["order_id"],
+                }
+            ],
+        }
+        assert table_nodes["db2.customers"] == expected_customers_node
+        assert table_nodes["db2.orders"] == expected_orders_node
+        assert table_nodes["db2.order_items"] == expected_items_node
+        assert table_nodes["db2.summary"] == {"id": "db2.summary"}
+
+        col_nodes = {
+            e["data"]["id"]: e["data"]
+            for e in nx_col
+            if "source" not in e["data"]
+        }
+        assert col_nodes["db2.orders.order_id"]["keys"] == ["PK"]
+        assert col_nodes["db2.orders.customer_id"]["keys"] == ["FK"]
+        assert col_nodes["db2.order_items.order_id"]["keys"] == ["PK", "FK"]
+        assert "keys" not in col_nodes["db2.customers.name"]
+        assert "keys" not in col_nodes["db2.summary.order_id"]
+        assert col_nodes["db2.orders"]["primary_key"] == ["order_id"]
+        assert "primary_key" not in col_nodes["db2.summary"]
