+@dataclass(frozen=True)
+class TableKeys:
+    """
+    Data Class for TableKeys
+    """
+
+    primary_key: tuple[str, ...] = ()
+    foreign_keys: tuple[ForeignKey, ...] = ()
+
+    def __post_init__(self) -> None:
+        object.__setattr__(
+            self,
+            "primary_key",
+            tuple(Column(col).raw_name for col in self.primary_key),
+        )
+        object.__setattr__(
+            self,
+            "foreign_keys",
+            tuple(
+                sorted(
+                    self.foreign_keys,
+                    key=lambda fk: (
+                        fk.columns,
+                        str(fk.referred_table),
+                        fk.referred_columns,
+                    ),
+                )
+            ),
+        )
+
+    def __bool__(self) -> bool:
+        return bool(self.primary_key or self.foreign_keys)
